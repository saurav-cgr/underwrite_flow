# Copy to .env for optional local overrides. Never commit real credentials.
# development | evaluation | production. Production refuses evaluation data
# loading. This is an environment selection only, not a readiness claim.
ENVIRONMENT_MODE=development
POSTGRES_DB=underwriteflow
POSTGRES_USER=underwriteflow
POSTGRES_PASSWORD=synthetic-local-password
# DATABASE_URL defaults to the local service in config.py.
SESSION_SECRET=synthetic-local-session-secret
JWT_ISSUER=underwriteflow
JWT_AUDIENCE=underwriteflow-web
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=28800
# Keys the stored refresh digest. Use a private value outside local demos.
REFRESH_TOKEN_PEPPER=synthetic-local-refresh-pepper
# Gemini is default provider when later workflow steps enable generation.
GENERATION_PROVIDER=gemini
# EMBEDDING_PROVIDER: fake | gemini | ollama
EMBEDDING_PROVIDER=fake
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Confirm the configured Gemini project is approved for no-training use.
GEMINI_NO_TRAINING_ACKNOWLEDGED=false
# Exact provider hosts approved for this deployment.
PROVIDER_ALLOWED_HOSTS=["generativelanguage.googleapis.com","ollama"]
# JSON array of deployment-specific literal values to redact before Gemini.
PII_REDACTION_TERMS=[]
PROVIDER_TIMEOUT_SECONDS=30
PROVIDER_RETRY_COUNT=2

# Optional local provider, enabled with: docker compose --profile ollama up
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=embeddinggemma

# Development/evaluation tracing only. Keep disabled for default local runs.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://apac.api.smith.langchain.com
LANGSMITH_PROJECT=underwriteflow-local
